<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  
  <bpmn:collaboration id="Collaboration_QuyTrinhTongQuat">
    <bpmn:participant id="Participant_HeThong" processRef="Process_QuanLyCongViec" />
  </bpmn:collaboration>

  <bpmn:process id="Process_QuanLyCongViec" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_NguoiGiao" name="Người giao / Quản lý (Lãnh đạo, Trưởng phòng)">
        <bpmn:flowNodeRef>Start_CapTren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TaoGiaoViec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DatYeuCau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PheDuyet</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_HeThong" name="Hệ thống">
        <bpmn:flowNodeRef>Task_Sys_GhiNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sys_100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sys_CanDuyet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_ChoDuyet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_HoanThanh_Auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_BaoLamLai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_LuuHoanThanh_Duyet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HoanThanh</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_NguoiNhan" name="Người thực hiện / Phối hợp (Chuyên viên)">
        <bpmn:flowNodeRef>Start_ChuyenVien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThucHien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapNhat</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Làn 1: Người giao -->
    <bpmn:startEvent id="Start_CapTren" name="Cấp trên khởi tạo CV">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_TaoGiaoViec" name="Nhập thông tin &#38; Giao việc">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KiemTra" name="Kiểm tra kết quả báo cáo">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DatYeuCau" name="Đạt yêu cầu?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_KhongDat</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dat</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PheDuyet" name="Phê duyệt công việc">
      <bpmn:incoming>Flow_Dat</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>

    <!-- Làn 2: Hệ thống -->
    <bpmn:task id="Task_Sys_GhiNhan" name="Hệ thống ghi nhận công việc">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Sys_To_ThucHien</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Sys_100" name="Tiến độ đã đạt 100%?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Chua100</bpmn:outgoing>
      <bpmn:outgoing>Flow_Da100</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Sys_CanDuyet" name="Công việc có cần duyệt?">
      <bpmn:incoming>Flow_Da100</bpmn:incoming>
      <bpmn:outgoing>Flow_KhongDuyet</bpmn:outgoing>
      <bpmn:outgoing>Flow_CanDuyet</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Sys_HoanThanh_Auto" name="Cập nhật trạng thái Hoàn thành">
      <bpmn:incoming>Flow_KhongDuyet</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Sys_ChoDuyet" name="Chuyển trạng thái Chờ duyệt &#38; Báo quản lý">
      <bpmn:incoming>Flow_CanDuyet</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Sys_BaoLamLai" name="Chuyển Đang thực hiện &#38; Báo làm lại">
      <bpmn:incoming>Flow_KhongDat</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Sys_LuuHoanThanh_Duyet" name="Cập nhật trạng thái Hoàn thành">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_HoanThanh" name="Đã hoàn thành">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Làn 3: Người nhận -->
    <bpmn:startEvent id="Start_ChuyenVien" name="Chuyên viên tự tạo CV">
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ThucHien" name="Thực hiện &#38; Phối hợp xử lý">
      <bpmn:incoming>Flow_Sys_To_ThucHien</bpmn:incoming>
      <bpmn:incoming>Flow_Chua100</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CapNhat" name="Cập nhật tiến độ &#38; Kết quả">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_CapTren" targetRef="Task_TaoGiaoViec" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_TaoGiaoViec" targetRef="Task_Sys_GhiNhan" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Start_ChuyenVien" targetRef="Task_Sys_GhiNhan" />
    
    <bpmn:sequenceFlow id="Flow_Sys_To_ThucHien" sourceRef="Task_Sys_GhiNhan" targetRef="Task_ThucHien" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ThucHien" targetRef="Task_CapNhat" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CapNhat" targetRef="Gateway_Sys_100" />
    
    <bpmn:sequenceFlow id="Flow_Chua100" name="Chưa 100%" sourceRef="Gateway_Sys_100" targetRef="Task_ThucHien" />
    <bpmn:sequenceFlow id="Flow_Da100" name="Đã 100%" sourceRef="Gateway_Sys_100" targetRef="Gateway_Sys_CanDuyet" />
    
    <bpmn:sequenceFlow id="Flow_KhongDuyet" name="Không cần duyệt (VD: Tự tạo)" sourceRef="Gateway_Sys_CanDuyet" targetRef="Task_Sys_HoanThanh_Auto" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Sys_HoanThanh_Auto" targetRef="End_HoanThanh" />
    
    <bpmn:sequenceFlow id="Flow_CanDuyet" name="Cần duyệt" sourceRef="Gateway_Sys_CanDuyet" targetRef="Task_Sys_ChoDuyet" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Sys_ChoDuyet" targetRef="Task_KiemTra" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_KiemTra" targetRef="Gateway_DatYeuCau" />
    
    <bpmn:sequenceFlow id="Flow_KhongDat" name="Không (Làm lại)" sourceRef="Gateway_DatYeuCau" targetRef="Task_Sys_BaoLamLai" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Sys_BaoLamLai" targetRef="Task_ThucHien" />
    
    <bpmn:sequenceFlow id="Flow_Dat" name="Đạt yêu cầu" sourceRef="Gateway_DatYeuCau" targetRef="Task_PheDuyet" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_PheDuyet" targetRef="Task_Sys_LuuHoanThanh_Duyet" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Sys_LuuHoanThanh_Duyet" targetRef="End_HoanThanh" />

  </bpmn:process>

  <!-- BPMNDI: Tọa độ hiển thị -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
