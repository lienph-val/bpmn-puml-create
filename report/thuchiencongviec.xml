        <bpmndi:BPMNLabel>
          <dc:Bounds x="1010" y="120" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- SHAPES: Chuyên viên Vòng lặp -->
      <bpmndi:BPMNShape id="Gateway_Merge_Loop_di" bpmnElement="Gateway_Merge_Loop" isMarkerVisible="true">
        <dc:Bounds x="1025" y="280" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CV_ThucHien_di" bpmnElement="Task_CV_ThucHien">
