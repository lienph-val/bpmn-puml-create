<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_User" name="Người dùng" processRef="Process_User" />
    <bpmn:participant id="Participant_IAM" name="Hệ thống IAM" processRef="Process_IAM" />
    <bpmn:messageFlow id="Flow_Msg1" sourceRef="Task_EnterCredentials" targetRef="Task_CheckTenant" />
    <bpmn:messageFlow id="Flow_Msg2" sourceRef="Task_CreateSession" targetRef="Task_AccessSystem" />
    <bpmn:messageFlow id="Flow_Msg3" sourceRef="Task_ReturnError" targetRef="Task_EnterCredentials" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="StartEvent_User" name="Bắt đầu">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_EnterCredentials" name="Nhập thông tin đăng nhập">
      <bpmn:incoming>Flow_1</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_AccessSystem" name="Truy cập Dashboard">
      <bpmn:outgoing>Flow_EndUser</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_User" name="Hoàn tất">
      <bpmn:incoming>Flow_EndUser</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_User" targetRef="Task_EnterCredentials" />
    <bpmn:sequenceFlow id="Flow_EndUser" sourceRef="Task_AccessSystem" targetRef="EndEvent_User" />
  </bpmn:process>
  <bpmn:process id="Process_IAM" isExecutable="false">
    <bpmn:task id="Task_CheckTenant" name="Kiểm tra trạng thái Doanh nghiệp (Tenant)">
      <bpmn:outgoing>Flow_Gate1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Tenant" name="Tenant hợp lệ?">
      <bpmn:incoming>Flow_Gate1</bpmn:incoming>
      <bpmn:outgoing>Flow_T_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_T_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckUser" name="Kiểm tra Tài khoản &#38; Số lần đăng nhập sai">
      <bpmn:incoming>Flow_T_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_User" name="Tài khoản hợp lệ?">
      <bpmn:incoming>Flow_Gate2</bpmn:incoming>
      <bpmn:outgoing>Flow_U_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_U_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReturnError" name="Báo lỗi &#38; Từ chối truy cập">
      <bpmn:incoming>Flow_T_No</bpmn:incoming>
      <bpmn:incoming>Flow_U_No</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_CreateSession" name="Ghi nhận Audit Log &#38; Khởi tạo phiên làm việc">
      <bpmn:incoming>Flow_U_Yes</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Gate1" sourceRef="Task_CheckTenant" targetRef="Gateway_Tenant" />
    <bpmn:sequenceFlow id="Flow_T_No" name="Bị khóa" sourceRef="Gateway_Tenant" targetRef="Task_ReturnError" />
    <bpmn:sequenceFlow id="Flow_T_Yes" name="OK" sourceRef="Gateway_Tenant" targetRef="Task_CheckUser" />
    <bpmn:sequenceFlow id="Flow_Gate2" sourceRef="Task_CheckUser" targetRef="Gateway_User" />
    <bpmn:sequenceFlow id="Flow_U_No" name="Sai/Bị khóa" sourceRef="Gateway_User" targetRef="Task_ReturnError" />
    <bpmn:sequenceFlow id="Flow_U_Yes" name="Hợp lệ" sourceRef="Gateway_User" targetRef="Task_CreateSession" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="850" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_IAM_di" bpmnElement="Participant_IAM" isHorizontal="true">
        <dc:Bounds x="120" y="260" width="850" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_User_di" bpmnElement="StartEvent_User">
        <dc:Bounds x="180" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterCredentials_di" bpmnElement="Task_EnterCredentials">
        <dc:Bounds x="260" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AccessSystem_di" bpmnElement="Task_AccessSystem">
        <dc:Bounds x="780" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_User_di" bpmnElement="EndEvent_User">
        <dc:Bounds x="910" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="150" />
        <di:waypoint x="260" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EndUser_di" bpmnElement="Flow_EndUser">
        <di:waypoint x="880" y="150" />
        <di:waypoint x="910" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Task_CheckTenant_di" bpmnElement="Task_CheckTenant">
        <dc:Bounds x="260" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Tenant_di" bpmnElement="Gateway_Tenant" isMarkerVisible="true">
        <dc:Bounds x="405" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="390" y="275" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckUser_di" bpmnElement="Task_CheckUser">
        <dc:Bounds x="500" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_User_di" bpmnElement="Gateway_User" isMarkerVisible="true">
        <dc:Bounds x="645" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="630" y="275" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnError_di" bpmnElement="Task_ReturnError">
        <dc:Bounds x="500" y="410" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateSession_di" bpmnElement="Task_CreateSession">
        <dc:Bounds x="780" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Gate1_di" bpmnElement="Flow_Gate1">
        <di:waypoint x="360" y="320" />
        <di:waypoint x="405" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_No_di" bpmnElement="Flow_T_No">
        <di:waypoint x="430" y="345" />
        <di:waypoint x="430" y="450" />
        <di:waypoint x="500" y="450" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="438" y="380" width="37" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_Yes_di" bpmnElement="Flow_T_Yes">
        <di:waypoint x="455" y="320" />
        <di:waypoint x="500" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="468" y="302" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gate2_di" bpmnElement="Flow_Gate2">
        <di:waypoint x="600" y="320" />
        <di:waypoint x="645" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U_No_di" bpmnElement="Flow_U_No">
        <di:waypoint x="670" y="345" />
        <di:waypoint x="670" y="450" />
        <di:waypoint x="600" y="450" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="678" y="380" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U_Yes_di" bpmnElement="Flow_U_Yes">
        <di:waypoint x="695" y="320" />
        <di:waypoint x="780" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="721" y="302" width="34" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg1_di" bpmnElement="Flow_Msg1">
        <di:waypoint x="310" y="190" />
        <di:waypoint x="310" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg2_di" bpmnElement="Flow_Msg2">
        <di:waypoint x="830" y="280" />
        <di:waypoint x="830" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg3_di" bpmnElement="Flow_Msg3">
        <di:waypoint x="500" y="450" />
        <di:waypoint x="238" y="450" />
        <di:waypoint x="238" y="170" />
        <di:waypoint x="260" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>