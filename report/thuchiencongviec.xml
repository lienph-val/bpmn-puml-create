        <di:waypoint x="1050" y="705" />
        <di:waypoint x="1050" y="780" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="688" width="34" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <!-- Không có nhu cầu xin GH -> Vòng lại (Bọc phải X=1150) -->
      <bpmndi:BPMNEdge id="Flow_Return_KhongGH_di" bpmnElement="Flow_Return_KhongGH">
        <di:waypoint x="1075" y="805" />
        <di:waypoint x="1150" y="805" />
        <di:waypoint x="1150" y="305" />
        <di:waypoint x="1075" y="305" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1085" y="788" width="34" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Có nhu cầu xin GH -->
      <bpmndi:BPMNEdge id="Flow_CoNhuCauGH_di" bpmnElement="Flow_CoNhuCauGH">
        <di:waypoint x="1050" y="830" />
        <di:waypoint x="1050" y="880" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1060" y="843" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_TP_Xem_di" bpmnElement="Flow_To_TP_Xem">
        <di:waypoint x="1000" y="920" />
        <di:waypoint x="350" y="920" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_GW_DongY_di" bpmnElement="Flow_To_GW_DongY">
        <di:waypoint x="300" y="960" />
        <di:waypoint x="300" y="980" />
      </bpmndi:BPMNEdge>
      
      <!-- Đồng ý GH -->
      <bpmndi:BPMNEdge id="Flow_GH_Yes_di" bpmnElement="Flow_GH_Yes">
        <di:waypoint x="325" y="1005" />
        <di:waypoint x="650" y="1005" />
        <di:waypoint x="650" y="990" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="340" y="988" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Return_GH_Yes_di" bpmnElement="Flow_Return_GH_Yes">
        <di:waypoint x="700" y="990" />
        <di:waypoint x="725" y="990" />
