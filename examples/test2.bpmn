        <bpmndi:BPMNLabel><dc:Bounds x="280" y="387" width="13" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_SoLuong_Khong_di" bpmnElement="Flow_SoLuong_Khong">
