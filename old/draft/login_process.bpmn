<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_User" name="Người dùng" processRef="Process_User" />
    <bpmn:participant id="Participant_IAM" name="Hệ thống IAM" processRef="Process_IAM" />
    <bpmn:messageFlow id="Flow_Msg1" sourceRef="Task_EnterCredentials" targetRef="Task_Validate" />
    <bpmn:messageFlow id="Flow_Msg2" sourceRef="Task_ReturnToken" targetRef="Task_AccessSystem" />
    <bpmn:messageFlow id="Flow_Msg3" sourceRef="Task_ReturnError" targetRef="Task_EnterCredentials" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="StartEvent_User" name="Bắt đầu">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_EnterCredentials" name="Nhập Email và Password">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_Wait" name="Chờ phản hồi">
      <bpmn:incoming>Flow_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_AccessSystem" name="Truy cập hệ thống">
      <bpmn:incoming>Flow_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_EndUser</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_User" name="Hoàn tất">
      <bpmn:incoming>Flow_EndUser</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_User" targetRef="Task_EnterCredentials" />
    <bpmn:sequenceFlow id="Flow_Wait" sourceRef="Task_EnterCredentials" targetRef="Event_Wait" />
    <bpmn:sequenceFlow id="Flow_Receive" sourceRef="Event_Wait" targetRef="Task_AccessSystem" />
    <bpmn:sequenceFlow id="Flow_EndUser" sourceRef="Task_AccessSystem" targetRef="EndEvent_User" />
  </bpmn:process>
  <bpmn:process id="Process_IAM" isExecutable="false">
    <bpmn:task id="Task_Validate" name="Kiểm tra thông tin">
      <bpmn:outgoing>Flow_Gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Hợp lệ?">
      <bpmn:incoming>Flow_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReturnError" name="Báo lỗi">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_CreateSession" name="Tạo phiên làm việc (JWT)">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnToken</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReturnToken" name="Cấp Token">
      <bpmn:incoming>Flow_ReturnToken</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Gateway" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Invalid" name="Không" sourceRef="Gateway_Valid" targetRef="Task_ReturnError" />
    <bpmn:sequenceFlow id="Flow_Valid" name="Có" sourceRef="Gateway_Valid" targetRef="Task_CreateSession" />
    <bpmn:sequenceFlow id="Flow_ReturnToken" sourceRef="Task_CreateSession" targetRef="Task_ReturnToken" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="750" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_IAM_di" bpmnElement="Participant_IAM" isHorizontal="true">
        <dc:Bounds x="120" y="300" width="750" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_User_di" bpmnElement="StartEvent_User">
        <dc:Bounds x="180" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterCredentials_di" bpmnElement="Task_EnterCredentials">
        <dc:Bounds x="270" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AccessSystem_di" bpmnElement="Task_AccessSystem">
        <dc:Bounds x="650" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="270" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="425" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="432" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnError_di" bpmnElement="Task_ReturnError">
        <dc:Bounds x="400" y="300" width="100" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateSession_di" bpmnElement="Task_CreateSession">
        <dc:Bounds x="520" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnToken_di" bpmnElement="Task_ReturnToken">
        <dc:Bounds x="650" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="170" />
        <di:waypoint x="270" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_di" bpmnElement="Flow_Gateway">
        <di:waypoint x="370" y="400" />
        <di:waypoint x="425" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid">
        <di:waypoint x="450" y="375" />
        <di:waypoint x="450" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid">
        <di:waypoint x="475" y="400" />
        <di:waypoint x="520" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReturnToken_di" bpmnElement="Flow_ReturnToken">
        <di:waypoint x="620" y="400" />
        <di:waypoint x="650" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg1_di" bpmnElement="Flow_Msg1">
        <di:waypoint x="320" y="210" />
        <di:waypoint x="320" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg2_di" bpmnElement="Flow_Msg2">
        <di:waypoint x="700" y="360" />
        <di:waypoint x="700" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg3_di" bpmnElement="Flow_Msg3">
        <di:waypoint x="400" y="320" />
        <di:waypoint x="360" y="320" />
        <di:waypoint x="360" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>