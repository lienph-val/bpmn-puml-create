        <bpmndi:BPMNLabel>
          <dc:Bounds x="215" y="998" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sys_CapNhatHan_di" bpmnElement="Task_Sys_CapNhatHan">
        <dc:Bounds x="600" y="950" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sys_GiuNguyenHan_di" bpmnElement="Task_Sys_GiuNguyenHan">
        <dc:Bounds x="600" y="1050" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- SHAPES: Nhánh = 100% -->
      <bpmndi:BPMNShape id="Task_Sys_ChotTime_di" bpmnElement="Task_Sys_ChotTime">
        <dc:Bounds x="600" y="780" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckDuyet_di" bpmnElement="Gateway_CheckDuyet" isMarkerVisible="true">
        <dc:Bounds x="625" y="880" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="545" y="891" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Tự động Hoàn thành (Không duyệt) -->
      <bpmndi:BPMNShape id="Task_Sys_HoanThanhTuDong_di" bpmnElement="Task_Sys_HoanThanhTuDong">
        <dc:Bounds x="480" y="980" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_HoanThanh_di" bpmnElement="End_HoanThanh">
        <dc:Bounds x="512" y="1080" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="490" y="1123" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Chờ Duyệt (Có duyệt) -->
      <bpmndi:BPMNShape id="Task_CV_GuiDuyet_di" bpmnElement="Task_CV_GuiDuyet">
        <dc:Bounds x="875" y="980" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sys_ChuyenChoDuyet_di" bpmnElement="Task_Sys_ChuyenChoDuyet">
        <dc:Bounds x="650" y="1080" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ChoDuyet_di" bpmnElement="End_ChoDuyet">
