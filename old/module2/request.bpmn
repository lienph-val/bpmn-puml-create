<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Workflow" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Workflow">
    <bpmn:participant id="Participant_User" name="Nhân viên khởi tạo / Xử lý" processRef="Process_User" />
    <bpmn:participant id="Participant_Engine" name="Hệ thống Quản lý Quy trình BPM" processRef="Process_Engine" />
    <bpmn:messageFlow id="Flow_M1" sourceRef="Task_CreateRequest" targetRef="Task_CheckLimit" />
    <bpmn:messageFlow id="Flow_M2" sourceRef="Task_RejectNotice" targetRef="Task_CreateRequest" />
    <bpmn:messageFlow id="Flow_M3" sourceRef="Task_GenerateTasks" targetRef="Task_ExecuteWorks" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="StartEvent_User" name="Có nhu cầu mua sắm">
      <bpmn:outgoing>Flow_U1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CreateRequest" name="Tạo và gửi Đề xuất mua sắm">
      <bpmn:incoming>Flow_U1</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_ExecuteWorks" name="Thực hiện đầu việc phối hợp liên phòng">
      <bpmn:outgoing>Flow_U2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_User" name="Quy trình hoàn tất">
      <bpmn:incoming>Flow_U2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_U1" sourceRef="StartEvent_User" targetRef="Task_CreateRequest" />
    <bpmn:sequenceFlow id="Flow_U2" sourceRef="Task_ExecuteWorks" targetRef="EndEvent_User" />
  </bpmn:process>
  <bpmn:process id="Process_Engine" isExecutable="false">
    <bpmn:task id="Task_CheckLimit" name="Kiểm tra hạn mức ngân sách">
      <bpmn:outgoing>Flow_E1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Budget" name="Vượt hạn mức phòng?">
      <bpmn:incoming>Flow_E1</bpmn:incoming>
      <bpmn:outgoing>Flow_Over</bpmn:outgoing>
      <bpmn:outgoing>Flow_Under</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RouteCEO" name="Định tuyến duyệt cấp Cao (CEO)">
      <bpmn:incoming>Flow_Over</bpmn:incoming>
      <bpmn:outgoing>Flow_E2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RouteManager" name="Định tuyến duyệt cấp Phòng (Manager)">
      <bpmn:incoming>Flow_Under</bpmn:incoming>
      <bpmn:outgoing>Flow_E3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Kết quả xét duyệt?">
      <bpmn:incoming>Flow_E2</bpmn:incoming>
      <bpmn:incoming>Flow_E3</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RejectNotice" name="Hủy đề xuất và cập nhật Dashboard từ chối">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_GenerateTasks" name="Tự động sinh đầu việc ngang &#38; Đồng bộ chỉ số Dashboard">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_E1" sourceRef="Task_CheckLimit" targetRef="Gateway_Budget" />
    <bpmn:sequenceFlow id="Flow_Over" name="Có" sourceRef="Gateway_Budget" targetRef="Task_RouteCEO" />
    <bpmn:sequenceFlow id="Flow_Under" name="Không" sourceRef="Gateway_Budget" targetRef="Task_RouteManager" />
    <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_RouteCEO" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_E3" sourceRef="Task_RouteManager" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Chấp thuận" sourceRef="Gateway_Decision" targetRef="Task_GenerateTasks" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Từ chối" sourceRef="Gateway_Decision" targetRef="Task_RejectNotice" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Workflow">
    <bpmndi:BPMNPlane id="BPMNPlane_Workflow" bpmnElement="Collaboration_Workflow">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="130" y="70" width="880" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Engine_di" bpmnElement="Participant_Engine" isHorizontal="true">
        <dc:Bounds x="130" y="270" width="880" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_User_di" bpmnElement="StartEvent_User">
        <dc:Bounds x="190" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateRequest_di" bpmnElement="Task_CreateRequest">
        <dc:Bounds x="280" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecuteWorks_di" bpmnElement="Task_ExecuteWorks">
        <dc:Bounds x="740" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_User_di" bpmnElement="EndEvent_User">
        <dc:Bounds x="900" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_U1_di" bpmnElement="Flow_U1">
        <di:waypoint x="226" y="150" />
        <di:waypoint x="280" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U2_di" bpmnElement="Flow_U2">
        <di:waypoint x="840" y="150" />
        <di:waypoint x="900" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Task_CheckLimit_di" bpmnElement="Task_CheckLimit">
        <dc:Bounds x="280" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Budget_di" bpmnElement="Gateway_Budget" isMarkerVisible="true">
        <dc:Bounds x="425" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RouteCEO_di" bpmnElement="Task_RouteCEO">
        <dc:Bounds x="520" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RouteManager_di" bpmnElement="Task_RouteManager">
        <dc:Bounds x="520" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="655" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectNotice_di" bpmnElement="Task_RejectNotice">
        <dc:Bounds x="740" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateTasks_di" bpmnElement="Task_GenerateTasks">
        <dc:Bounds x="740" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_E1_di" bpmnElement="Flow_E1">
        <di:waypoint x="380" y="400" />
        <di:waypoint x="425" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Over_di" bpmnElement="Flow_Over">
        <di:waypoint x="450" y="375" />
        <di:waypoint x="450" y="340" />
        <di:waypoint x="520" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Under_di" bpmnElement="Flow_Under">
        <di:waypoint x="450" y="425" />
        <di:waypoint x="450" y="460" />
        <di:waypoint x="520" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E2_di" bpmnElement="Flow_E2">
        <di:waypoint x="620" y="340" />
        <di:waypoint x="680" y="340" />
        <di:waypoint x="680" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E3_di" bpmnElement="Flow_E3">
        <di:waypoint x="620" y="460" />
        <di:waypoint x="680" y="460" />
        <di:waypoint x="680" y="425" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="705" y="400" />
        <di:waypoint x="722" y="400" />
        <di:waypoint x="722" y="340" />
        <di:waypoint x="740" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="705" y="400" />
        <di:waypoint x="722" y="400" />
        <di:waypoint x="722" y="460" />
        <di:waypoint x="740" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M1_di" bpmnElement="Flow_M1">
        <di:waypoint x="330" y="190" />
        <di:waypoint x="330" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M2_di" bpmnElement="Flow_M2">
        <di:waypoint x="790" y="420" />
        <di:waypoint x="790" y="250" />
        <di:waypoint x="360" y="250" />
        <di:waypoint x="360" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M3_di" bpmnElement="Flow_M3">
        <di:waypoint x="790" y="300" />
        <di:waypoint x="790" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>