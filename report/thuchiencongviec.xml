          <dc:Bounds x="660" y="1223" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ================= EDGES ================= -->
      <bpmndi:BPMNEdge id="Flow_Start_To_Loop_di" bpmnElement="Flow_Start_To_Loop">
        <di:waypoint x="1050" y="186" />
        <di:waypoint x="1050" y="280" />
      </bpmndi:BPMNEdge>

      <!-- Vòng lặp -->
      <bpmndi:BPMNEdge id="Flow_To_ThucHien_di" bpmnElement="Flow_To_ThucHien">
        <di:waypoint x="1050" y="330" />
        <di:waypoint x="1050" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_CapNhat_di" bpmnElement="Flow_To_CapNhat">
        <di:waypoint x="1050" y="460" />
        <di:waypoint x="1050" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Sys_Tinh_di" bpmnElement="Flow_To_Sys_Tinh">
        <di:waypoint x="1000" y="520" />
        <di:waypoint x="650" y="520" />
        <di:waypoint x="650" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Check100_di" bpmnElement="Flow_To_Check100">
        <di:waypoint x="650" y="660" />
        <di:waypoint x="650" y="680" />
      </bpmndi:BPMNEdge>

      <!-- Nhánh < 100% -->
      <bpmndi:BPMNEdge id="Flow_Chua100_di" bpmnElement="Flow_Chua100">
