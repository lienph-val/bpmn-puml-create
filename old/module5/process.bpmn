<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Finance" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Finance">
    <bpmn:participant id="Participant_Emp" name="Nhân viên" processRef="Process_Emp" />
    <bpmn:participant id="Participant_System" name="Hệ thống Tài chính" processRef="Process_System" />
    <bpmn:participant id="Participant_Acc" name="Kế toán" processRef="Process_Acc" />
    <bpmn:messageFlow id="Flow_M1" sourceRef="Task_CreateAdv" targetRef="Task_CheckBudget" />
    <bpmn:messageFlow id="Flow_M2" sourceRef="Task_ApproveSys" targetRef="Task_Disburse" />
    <bpmn:messageFlow id="Flow_M3" sourceRef="Task_SubmitOCR" targetRef="Task_ExtractOCR" />
    <bpmn:messageFlow id="Flow_M4" sourceRef="Task_ExtractOCR" targetRef="Task_Reconcile" />
    <bpmn:messageFlow id="Flow_M5" sourceRef="Task_ReqMoreDocs" targetRef="Task_SubmitOCR" />
    <bpmn:messageFlow id="Flow_M6" sourceRef="Task_RejectAdv" targetRef="Task_CreateAdv" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_Emp" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Phát sinh chi phí">
      <bpmn:outgoing>Flow_E1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CreateAdv" name="Tạo Đề nghị Tạm ứng">
      <bpmn:incoming>Flow_E1</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_SubmitOCR" name="Tải hóa đơn (Hoàn ứng)">
      <bpmn:outgoing>Flow_E2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Kết thúc">
      <bpmn:incoming>Flow_E2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E1" sourceRef="StartEvent_1" targetRef="Task_CreateAdv" />
    <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_SubmitOCR" targetRef="EndEvent_1" />
  </bpmn:process>
  
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:task id="Task_CheckBudget" name="Kiểm tra Ngân sách &#38; Phê duyệt tự động">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Budget" name="Ngân sách đủ?">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_Budget_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Budget_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ApproveSys" name="Ghi nhận duyệt đơn">
      <bpmn:incoming>Flow_Budget_Yes</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_RejectAdv" name="Từ chối đề nghị">
      <bpmn:incoming>Flow_Budget_No</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_ExtractOCR" name="AI OCR bóc tách dữ liệu Hóa đơn" />
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Task_CheckBudget" targetRef="Gateway_Budget" />
    <bpmn:sequenceFlow id="Flow_Budget_Yes" name="Có" sourceRef="Gateway_Budget" targetRef="Task_ApproveSys" />
    <bpmn:sequenceFlow id="Flow_Budget_No" name="Không" sourceRef="Gateway_Budget" targetRef="Task_RejectAdv" />
  </bpmn:process>
  
  <bpmn:process id="Process_Acc" isExecutable="false">
    <bpmn:task id="Task_Disburse" name="Kiểm tra &#38; Thực hiện Chi tiền">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RecordDebt" name="Ghi nhận Công nợ Nhân viên">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_Reconcile" name="Duyệt chứng từ &#38; Đối soát Hoàn ứng">
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Docs" name="Chứng từ hợp lệ?">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_Doc_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Doc_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RecordExpense" name="Ghi sổ Chi phí &#38; Cấn trừ công nợ">
      <bpmn:incoming>Flow_Doc_Yes</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_ReqMoreDocs" name="Yêu cầu bổ sung chứng từ">
      <bpmn:incoming>Flow_Doc_No</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Task_Disburse" targetRef="Task_RecordDebt" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_Reconcile" targetRef="Gateway_Docs" />
    <bpmn:sequenceFlow id="Flow_Doc_Yes" name="Có" sourceRef="Gateway_Docs" targetRef="Task_RecordExpense" />
    <bpmn:sequenceFlow id="Flow_Doc_No" name="Không" sourceRef="Gateway_Docs" targetRef="Task_ReqMoreDocs" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Finance">
      <bpmndi:BPMNShape id="Participant_Emp_di" bpmnElement="Participant_Emp" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1180" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_System_di" bpmnElement="Participant_System" isHorizontal="true">
        <dc:Bounds x="120" y="250" width="1180" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Acc_di" bpmnElement="Participant_Acc" isHorizontal="true">
        <dc:Bounds x="120" y="450" width="1180" height="200" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateAdv_di" bpmnElement="Task_CreateAdv">
        <dc:Bounds x="260" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitOCR_di" bpmnElement="Task_SubmitOCR">
        <dc:Bounds x="650" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="850" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_E1_di" bpmnElement="Flow_E1">
        <di:waypoint x="216" y="150" />
        <di:waypoint x="260" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E2_di" bpmnElement="Flow_E2">
        <di:waypoint x="750" y="150" />
        <di:waypoint x="850" y="150" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNShape id="Task_CheckBudget_di" bpmnElement="Task_CheckBudget">
        <dc:Bounds x="260" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Budget_di" bpmnElement="Gateway_Budget" isMarkerVisible="true">
        <dc:Bounds x="400" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="390" y="290" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveSys_di" bpmnElement="Task_ApproveSys">
        <dc:Bounds x="500" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectAdv_di" bpmnElement="Task_RejectAdv">
        <dc:Bounds x="500" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExtractOCR_di" bpmnElement="Task_ExtractOCR">
        <dc:Bounds x="650" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_S1_di" bpmnElement="Flow_S1">
        <di:waypoint x="360" y="340" />
        <di:waypoint x="400" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Budget_Yes_di" bpmnElement="Flow_Budget_Yes">
        <di:waypoint x="425" y="315" />
        <di:waypoint x="425" y="310" />
        <di:waypoint x="500" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="290" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Budget_No_di" bpmnElement="Flow_Budget_No">
        <di:waypoint x="425" y="365" />
        <di:waypoint x="425" y="390" />
        <di:waypoint x="500" y="390" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="395" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNShape id="Task_Disburse_di" bpmnElement="Task_Disburse">
        <dc:Bounds x="500" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordDebt_di" bpmnElement="Task_RecordDebt">
        <dc:Bounds x="650" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reconcile_di" bpmnElement="Task_Reconcile">
        <dc:Bounds x="800" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Docs_di" bpmnElement="Gateway_Docs" isMarkerVisible="true">
        <dc:Bounds x="950" y="485" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="935" y="460" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordExpense_di" bpmnElement="Task_RecordExpense">
        <dc:Bounds x="1050" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReqMoreDocs_di" bpmnElement="Task_ReqMoreDocs">
        <dc:Bounds x="1050" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_A1_di" bpmnElement="Flow_A1">
        <di:waypoint x="600" y="510" />
        <di:waypoint x="650" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A2_di" bpmnElement="Flow_A2">
        <di:waypoint x="900" y="510" />
        <di:waypoint x="950" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Doc_Yes_di" bpmnElement="Flow_Doc_Yes">
        <di:waypoint x="975" y="485" />
        <di:waypoint x="975" y="500" />
        <di:waypoint x="1050" y="500" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="980" y="480" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Doc_No_di" bpmnElement="Flow_Doc_No">
        <di:waypoint x="975" y="535" />
        <di:waypoint x="975" y="590" />
        <di:waypoint x="1050" y="590" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="980" y="595" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_M1_di" bpmnElement="Flow_M1">
        <di:waypoint x="310" y="190" />
        <di:waypoint x="310" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M2_di" bpmnElement="Flow_M2">
        <di:waypoint x="550" y="350" />
        <di:waypoint x="550" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M3_di" bpmnElement="Flow_M3">
        <di:waypoint x="700" y="190" />
        <di:waypoint x="700" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M4_di" bpmnElement="Flow_M4">
        <di:waypoint x="700" y="360" />
        <di:waypoint x="700" y="410" />
        <di:waypoint x="850" y="410" />
        <di:waypoint x="850" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M5_di" bpmnElement="Flow_M5">
        <di:waypoint x="1100" y="550" />
        <di:waypoint x="1100" y="60" />
        <di:waypoint x="700" y="60" />
        <di:waypoint x="700" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M6_di" bpmnElement="Flow_M6">
        <di:waypoint x="550" y="350" />
        <di:waypoint x="550" y="230" />
        <di:waypoint x="280" y="230" />
        <di:waypoint x="280" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>