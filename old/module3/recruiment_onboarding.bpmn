<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HRM" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HRM">
    <bpmn:participant id="Participant_HR" name="Bộ phận Nhân sự (HR)" processRef="Process_HR" />
    <bpmn:participant id="Participant_System" name="Hệ thống HRM &#38; IAM" processRef="Process_System" />
    <bpmn:messageFlow id="Flow_Msg1" sourceRef="Task_MoveKanban" targetRef="Task_CheckCandidate" />
    <bpmn:messageFlow id="Flow_Msg2" sourceRef="Task_CreateProfile" targetRef="Task_NotifyHR" />
  </bpmn:collaboration>
  <bpmn:process id="Process_HR" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Recruit" name="Có ứng viên mới">
      <bpmn:outgoing>Flow_H1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ScreenCV" name="Sàng lọc CV và Phỏng vấn">
      <bpmn:incoming>Flow_H1</bpmn:incoming>
      <bpmn:outgoing>Flow_H2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Pass" name="Ứng viên Đạt?">
      <bpmn:incoming>Flow_H2</bpmn:incoming>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject" name="Gửi thư cảm ơn (Từ chối)">
      <bpmn:incoming>Flow_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_HEnd1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Reject" name="Kết thúc">
      <bpmn:incoming>Flow_HEnd1</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:exclusiveGateway id="Gateway_Offer" name="Ứng viên đồng ý Offer?">
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_Offer_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Offer_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:endEvent id="EndEvent_Declined" name="Ứng viên từ chối">
      <bpmn:incoming>Flow_Offer_No</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_MoveKanban" name="Chuyển trạng thái sang Trúng tuyển">
      <bpmn:incoming>Flow_Offer_Yes</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_NotifyHR" name="Nhận thông báo Onboarding hoàn tất">
      <bpmn:outgoing>Flow_HEnd2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Success" name="Hoàn tất Onboarding">
      <bpmn:incoming>Flow_HEnd2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_H1" sourceRef="StartEvent_Recruit" targetRef="Task_ScreenCV" />
    <bpmn:sequenceFlow id="Flow_H2" sourceRef="Task_ScreenCV" targetRef="Gateway_Pass" />
    <bpmn:sequenceFlow id="Flow_Fail" name="Không đạt" sourceRef="Gateway_Pass" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_Pass" name="Đạt" sourceRef="Gateway_Pass" targetRef="Gateway_Offer" />
    <bpmn:sequenceFlow id="Flow_HEnd1" sourceRef="Task_Reject" targetRef="EndEvent_Reject" />
    
    <bpmn:sequenceFlow id="Flow_Offer_No" name="Từ chối" sourceRef="Gateway_Offer" targetRef="EndEvent_Declined" />
    <bpmn:sequenceFlow id="Flow_Offer_Yes" name="Đồng ý" sourceRef="Gateway_Offer" targetRef="Task_MoveKanban" />
    
    <bpmn:sequenceFlow id="Flow_HEnd2" sourceRef="Task_NotifyHR" targetRef="EndEvent_Success" />
  </bpmn:process>
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:task id="Task_CheckCandidate" name="Kiểm tra thông tin định danh (CCCD/Email)">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ValidData" name="Hợp lệ?">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Alert" name="Cảnh báo trùng lặp dữ liệu">
      <bpmn:incoming>Flow_S_No</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_CreateProfile" name="Tạo Hồ sơ gốc &#38; Cấp tài khoản IAM">
      <bpmn:incoming>Flow_S_Yes</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Task_CheckCandidate" targetRef="Gateway_ValidData" />
    <bpmn:sequenceFlow id="Flow_S_No" name="Trùng" sourceRef="Gateway_ValidData" targetRef="Task_Alert" />
    <bpmn:sequenceFlow id="Flow_S_Yes" name="OK" sourceRef="Gateway_ValidData" targetRef="Task_CreateProfile" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HRM">
    <bpmndi:BPMNPlane id="BPMNPlane_HRM" bpmnElement="Collaboration_HRM">
      <bpmndi:BPMNShape id="Participant_HR_di" bpmnElement="Participant_HR" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="950" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_System_di" bpmnElement="Participant_System" isHorizontal="true">
        <dc:Bounds x="120" y="320" width="950" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Recruit_di" bpmnElement="StartEvent_Recruit">
        <dc:Bounds x="180" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScreenCV_di" bpmnElement="Task_ScreenCV">
        <dc:Bounds x="260" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Pass_di" bpmnElement="Gateway_Pass" isMarkerVisible="true">
        <dc:Bounds x="405" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_di" bpmnElement="Task_Reject">
        <dc:Bounds x="490" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Reject_di" bpmnElement="EndEvent_Reject">
        <dc:Bounds x="640" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_Offer_di" bpmnElement="Gateway_Offer" isMarkerVisible="true">
        <dc:Bounds x="490" y="190" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="478" y="160" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Declined_di" bpmnElement="EndEvent_Declined">
        <dc:Bounds x="497" y="270" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="475" y="313" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_MoveKanban_di" bpmnElement="Task_MoveKanban">
        <dc:Bounds x="580" y="175" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyHR_di" bpmnElement="Task_NotifyHR">
        <dc:Bounds x="840" y="175" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="980" y="197" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_H1_di" bpmnElement="Flow_H1">
        <di:waypoint x="216" y="180" />
        <di:waypoint x="260" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_H2_di" bpmnElement="Flow_H2">
        <di:waypoint x="360" y="180" />
        <di:waypoint x="405" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fail_di" bpmnElement="Flow_Fail">
        <di:waypoint x="430" y="155" />
        <di:waypoint x="430" y="130" />
        <di:waypoint x="490" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Pass_di" bpmnElement="Flow_Pass">
        <di:waypoint x="430" y="205" />
        <di:waypoint x="430" y="215" />
        <di:waypoint x="490" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HEnd1_di" bpmnElement="Flow_HEnd1">
        <di:waypoint x="590" y="130" />
        <di:waypoint x="640" y="130" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Offer_No_di" bpmnElement="Flow_Offer_No">
        <di:waypoint x="515" y="240" />
        <di:waypoint x="515" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="520" y="245" width="37" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Offer_Yes_di" bpmnElement="Flow_Offer_Yes">
        <di:waypoint x="540" y="215" />
        <di:waypoint x="580" y="215" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="545" y="195" width="37" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_HEnd2_di" bpmnElement="Flow_HEnd2">
        <di:waypoint x="940" y="215" />
        <di:waypoint x="980" y="215" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNShape id="Task_CheckCandidate_di" bpmnElement="Task_CheckCandidate">
        <dc:Bounds x="580" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValidData_di" bpmnElement="Gateway_ValidData" isMarkerVisible="true">
        <dc:Bounds x="730" y="365" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Alert_di" bpmnElement="Task_Alert">
        <dc:Bounds x="840" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateProfile_di" bpmnElement="Task_CreateProfile">
        <dc:Bounds x="840" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_S1_di" bpmnElement="Flow_S1">
        <di:waypoint x="680" y="390" />
        <di:waypoint x="730" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_No_di" bpmnElement="Flow_S_No">
        <di:waypoint x="755" y="415" />
        <di:waypoint x="755" y="480" />
        <di:waypoint x="840" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_Yes_di" bpmnElement="Flow_S_Yes">
        <di:waypoint x="780" y="390" />
        <di:waypoint x="840" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg1_di" bpmnElement="Flow_Msg1">
        <di:waypoint x="630" y="255" />
        <di:waypoint x="630" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg2_di" bpmnElement="Flow_Msg2">
        <di:waypoint x="890" y="350" />
        <di:waypoint x="890" y="255" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>