@startuml
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Người dùng" as User
boundary "Giao diện\nQuản lý công việc" as UI
control "Hệ thống\nquản lý công việc" as System
database "CSDL" as DB

' =========================
' MỞ CHỨC NĂNG TẠO CÔNG VIỆC
' =========================

User -> UI : Chọn chức năng "Tạo công việc"
activate UI

UI -> System : Yêu cầu mở biểu mẫu tạo công việc
activate System

System --> UI : Hiển thị biểu mẫu khởi tạo công việc
deactivate System

UI --> User : Hiển thị biểu mẫu


' =========================
' NHẬP VÀ KIỂM TRA THÔNG TIN
' =========================

loop Cho đến khi dữ liệu hợp lệ \n hoặc người dùng hủy

    User -> UI : Nhập/chỉnh sửa thông tin\nTên CV, Mô tả, Deadline,\nƯu tiên, Tài liệu đính kèm

    break Người dùng nhấn "Hủy"

        User -> UI : Nhấn "Hủy"

        UI -> System : Yêu cầu hủy tạo công việc
        activate System

        System --> UI : Đóng biểu mẫu,\nkhông lưu dữ liệu
        deactivate System

        UI --> User : Hiển thị màn hình trước đó

        deactivate UI
    end

    User -> UI : Nhấn "Xác nhận" / "Lưu"

    UI -> System : Gửi thông tin công việc
    activate System

    System -> System : Kiểm tra tính hợp lệ\ndữ liệu đầu vào
    activate System
    deactivate System

    alt Thiếu thông tin bắt buộc

        System --> UI : Thông báo lỗi\nTên công việc/Deadline bắt buộc

        activate UI
        UI --> User : Hiển thị lỗi màu đỏ\ntại trường tương ứng
        deactivate UI

        deactivate System

    else Deadline không hợp lệ

        ' Bổ sung kích hoạt để đồng nhất giao diện (cosmetic)
        activate System 
        
        System --> UI : Thông báo Deadline\nkhông được nhỏ hơn hiện tại

        activate UI
        UI --> User : Hiển thị cảnh báo\nvà yêu cầu chọn lại
        deactivate UI

        deactivate System
        deactivate System

    else Dữ liệu hợp lệ

        break Lưu thành công và kết thúc
            
            System -> System : Gán người thực hiện\nlà người khởi tạo
            activate System
            deactivate System
            
            System -> System : Thiết lập công việc cá nhân
            activate System
            deactivate System

            System -> DB : Lưu dữ liệu công việc
            activate DB

            DB --> System : Xác nhận lưu thành công
            deactivate DB

            System --> UI : Thông báo tạo công việc thành công

            activate UI
            UI --> User : Hiển thị thông báo thành công
            deactivate UI

            System -> DB : Truy vấn danh sách công việc cá nhân
            activate DB

            DB --> System : Trả về danh sách cập nhật
            deactivate DB

            System --> UI : Cập nhật danh sách công việc

            UI --> User : Hiển thị công việc vừa tạo

            deactivate System
            deactivate UI

        end
    end

end

@enduml