<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_MuaHang" isExecutable="false">
    
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_Start_TaoDon</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_TaoDon" name="Tạo đơn mua hàng">
      <bpmn:incoming>Flow_Start_TaoDon</bpmn:incoming>
      <bpmn:outgoing>Flow_TaoDon_NhanHang</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_NhanHang" name="Nhận hàng">
      <bpmn:incoming>Flow_TaoDon_NhanHang</bpmn:incoming>
      <bpmn:outgoing>Flow_NhanHang_GWSoLuong</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="GW_SoLuong" name="Đúng số lượng/&#10;mẫu mã?">
      <bpmn:incoming>Flow_NhanHang_GWSoLuong</bpmn:incoming>
      <bpmn:outgoing>Flow_SoLuong_Co</bpmn:outgoing>
      <bpmn:outgoing>Flow_SoLuong_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:exclusiveGateway id="GW_CanQC" name="Hàng cần QC?">
      <bpmn:incoming>Flow_SoLuong_Co</bpmn:incoming>
      <bpmn:outgoing>Flow_CanQC_Co</bpmn:outgoing>
      <bpmn:outgoing>Flow_CanQC_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:exclusiveGateway id="GW_DatChuan" name="Hàng đạt chuẩn?">
      <bpmn:incoming>Flow_CanQC_Co</bpmn:incoming>
      <bpmn:outgoing>Flow_DatChuan_Co</bpmn:outgoing>
      <bpmn:outgoing>Flow_DatChuan_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_TraNCC" name="Lập phiếu trả NCC">
      <bpmn:incoming>Flow_SoLuong_Khong</bpmn:incoming>
      <bpmn:incoming>Flow_DatChuan_Khong</bpmn:incoming>
      <bpmn:outgoing>Flow_TraNCC_LuuHoSo</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_NhapKho" name="Lập phiếu nhập kho">
      <bpmn:incoming>Flow_CanQC_Khong</bpmn:incoming>
      <bpmn:incoming>Flow_DatChuan_Co</bpmn:incoming>
      <bpmn:outgoing>Flow_NhapKho_CapNhat</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_LuuHoSo" name="Lưu hồ sơ trả hàng">
      <bpmn:incoming>Flow_TraNCC_LuuHoSo</bpmn:incoming>
      <bpmn:outgoing>Flow_LuuHoSo_End</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CapNhat" name="Cập nhật tồn kho">
      <bpmn:incoming>Flow_NhapKho_CapNhat</bpmn:incoming>
      <bpmn:outgoing>Flow_CapNhat_End</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_LuuHoSo_End</bpmn:incoming>
      <bpmn:incoming>Flow_CapNhat_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_TaoDon" sourceRef="StartEvent_1" targetRef="Task_TaoDon" />
    <bpmn:sequenceFlow id="Flow_TaoDon_NhanHang" sourceRef="Task_TaoDon" targetRef="Task_NhanHang" />
    <bpmn:sequenceFlow id="Flow_NhanHang_GWSoLuong" sourceRef="Task_NhanHang" targetRef="GW_SoLuong" />
    
    <bpmn:sequenceFlow id="Flow_SoLuong_Co" name="Có" sourceRef="GW_SoLuong" targetRef="GW_CanQC" />
    <bpmn:sequenceFlow id="Flow_SoLuong_Khong" name="Không" sourceRef="GW_SoLuong" targetRef="Task_TraNCC" />
    
    <bpmn:sequenceFlow id="Flow_CanQC_Co" name="Có" sourceRef="GW_CanQC" targetRef="GW_DatChuan" />
    <bpmn:sequenceFlow id="Flow_CanQC_Khong" name="Không" sourceRef="GW_CanQC" targetRef="Task_NhapKho" />
    
    <bpmn:sequenceFlow id="Flow_DatChuan_Co" name="Có" sourceRef="GW_DatChuan" targetRef="Task_NhapKho" />
    <bpmn:sequenceFlow id="Flow_DatChuan_Khong" name="Không" sourceRef="GW_DatChuan" targetRef="Task_TraNCC" />
    
    <bpmn:sequenceFlow id="Flow_TraNCC_LuuHoSo" sourceRef="Task_TraNCC" targetRef="Task_LuuHoSo" />
    <bpmn:sequenceFlow id="Flow_NhapKho_CapNhat" sourceRef="Task_NhapKho" targetRef="Task_CapNhat" />
    <bpmn:sequenceFlow id="Flow_LuuHoSo_End" sourceRef="Task_LuuHoSo" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_CapNhat_End" sourceRef="Task_CapNhat" targetRef="EndEvent_1" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_MuaHang">
      
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="382" y="50" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_TaoDon_di" bpmnElement="Task_TaoDon">
        <dc:Bounds x="350" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_NhanHang_di" bpmnElement="Task_NhanHang">
        <dc:Bounds x="350" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="GW_SoLuong_di" bpmnElement="GW_SoLuong" isMarkerVisible="true">
        <dc:Bounds x="375" y="380" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="430" y="360" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="GW_CanQC_di" bpmnElement="GW_CanQC" isMarkerVisible="true">
        <dc:Bounds x="175" y="480" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="95" y="498" width="75" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="GW_DatChuan_di" bpmnElement="GW_DatChuan" isMarkerVisible="true">
        <dc:Bounds x="375" y="480" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="360" y="456" width="83" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_TraNCC_di" bpmnElement="Task_TraNCC">
        <dc:Bounds x="550" y="465" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_NhapKho_di" bpmnElement="Task_NhapKho">
        <dc:Bounds x="150" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_LuuHoSo_di" bpmnElement="Task_LuuHoSo">
        <dc:Bounds x="550" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_CapNhat_di" bpmnElement="Task_CapNhat">
        <dc:Bounds x="150" y="700" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="582" y="820" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_TaoDon_di" bpmnElement="Flow_Start_TaoDon">
        <di:waypoint x="400" y="86" />
        <di:waypoint x="400" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_TaoDon_NhanHang_di" bpmnElement="Flow_TaoDon_NhanHang">
        <di:waypoint x="400" y="200" />
        <di:waypoint x="400" y="250" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_NhanHang_GWSoLuong_di" bpmnElement="Flow_NhanHang_GWSoLuong">
        <di:waypoint x="400" y="330" />
        <di:waypoint x="400" y="380" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_SoLuong_Co_di" bpmnElement="Flow_SoLuong_Co">
        <di:waypoint x="375" y="405" />
