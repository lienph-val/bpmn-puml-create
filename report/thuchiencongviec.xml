      <bpmndi:BPMNShape id="Task_Sys_TinhTienDo_di" bpmnElement="Task_Sys_TinhTienDo">
        <dc:Bounds x="600" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Check100_di" bpmnElement="Gateway_Check100" isMarkerVisible="true">
        <dc:Bounds x="625" y="680" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="545" y="698" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- SHAPES: Nhánh < 100% & Xin Gia hạn -->
      <bpmndi:BPMNShape id="Gateway_NhuCauGH_di" bpmnElement="Gateway_NhuCauGH" isMarkerVisible="true">
        <dc:Bounds x="1025" y="780" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1080" y="791" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CV_XinGiaHan_di" bpmnElement="Task_CV_XinGiaHan">
        <dc:Bounds x="1000" y="880" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TP_XemXet_di" bpmnElement="Task_TP_XemXet">
